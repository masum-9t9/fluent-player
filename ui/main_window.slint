import { LineEdit, ListView } from "std-widgets.slint";

component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <image> hover-icon;
    in property <bool> active: false;
    in property <bool> place-item: false;
    in property <length> row-height: 48px;
    in property <bool> reduce-motion: false;
    callback selected();

    width: 100%;
    height: root.row-height;
    border-radius: 10px;
    background: root.active ? #241b0f : hover-area.has-hover ? #232323 : transparent;
    animate background { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }

    Rectangle {
        x: 0px;
        y: parent.height / 2 - self.height / 2;
        width: 3px;
        height: 30px;
        border-radius: 2px;
        opacity: root.active ? 1 : 0;
        background: #ff9900;
        animate opacity { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: root.place-item ? 12px : root.active ? 12px : 14px;
        spacing: 12px;
        Rectangle {
            width: root.place-item ? 18px : 20px;
            height: 100%;
            background: transparent;
            Image {
                source: root.active || hover-area.has-hover ? root.hover-icon : root.icon;
                width: root.place-item ? 18px : 20px;
                height: root.place-item ? 18px : 20px;
                x: parent.width / 2 - self.width / 2;
                y: parent.height / 2 - self.height / 2 + (hover-area.has-hover ? 0px : 1px);
                animate y { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
            }
        }
        Text {
            text: root.label;
            horizontal-stretch: 1;
            height: 100%;
            color: root.active ? #f5f5f7 : hover-area.has-hover ? #f0f1f4 : #b8bac4;
            font-size: root.place-item ? 13px : 13px;
            font-weight: root.active ? 700 : 400;
            vertical-alignment: center;
            animate color { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }
        }
    }

    hover-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }
}

component PlayerChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> reduce-motion: false;
    callback clicked();

    width: 38px;
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: root.active ? #70430e : hit.has-hover ? #454545 : #2a2a2a;
    background: hit.has-hover ? #332310 : root.active ? #261a0b : #1c1c1c;
    animate background { duration: root.reduce-motion ? 0ms : 130ms; easing: ease-out; }
    animate border-color { duration: root.reduce-motion ? 0ms : 130ms; easing: ease-out; }
    Text {
        text: root.label;
        color: root.active ? #ffad24 : #d4d7dc;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export struct MediaEntry {
    title: string,
    subtitle: string,
    path: string,
    thumbnail: image,
    playing: bool,
}

component MediaPage inherits Rectangle {
    in property <string> heading;
    in property <string> description;
    in property <[MediaEntry]> items;
    in property <bool> reduce-motion: false;
    callback choose-folder();
    callback open-item(string);
    callback toggle-favorite(string);
    background: transparent;

    VerticalLayout {
        width: 100%; height: 100%;
        padding-left: 28px; padding-right: 28px; padding-top: 22px; padding-bottom: 20px;
        spacing: 14px;
        HorizontalLayout {
            width: 100%; height: 46px; spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1; spacing: 2px;
                Text { text: root.heading; color: #f2f3f6; font-size: 17px; font-weight: 700; }
                Text { text: root.description; color: #999eaa; font-size: 11px; }
            }
            Rectangle {
                width: 116px; height: 40px; border-radius: 13px;
                border-width: 1px; border-color: folder-hover.has-hover ? #ffbd52 : #ffad24;
                background: folder-hover.pressed ? #d98200 : folder-hover.has-hover ? #ffad24 : #ff9900;
                animate background { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }
                animate border-color { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }
                Text { width: 100%; height: 100%; text: "Choose folder"; color: #071214; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                folder-hover := TouchArea { mouse-cursor: pointer; clicked => { root.choose-folder(); } }
            }
        }
        if root.items.length == 0: VerticalLayout {
            vertical-stretch: 1; alignment: center; spacing: 10px;
            Rectangle {
                width: 58px; height: 58px; border-radius: 17px; background: #141417;
                Image { source: @image-url("icons/folder-active.svg"); width: 24px; height: 24px; x: parent.width / 2 - self.width / 2; y: parent.height / 2 - self.height / 2; }
            }
            Text { text: "No videos here yet"; color: #f0f1f3; font-size: 19px; font-weight: 700; horizontal-alignment: center; }
            Text { text: "Choose a folder or open a video file to get started."; color: #9ba0ab; font-size: 12px; horizontal-alignment: center; }
        }
        if root.items.length > 0: ListView {
            width: 100%; vertical-stretch: 1;
            for entry[index] in root.items : Rectangle {
                width: 100%; height: 82px; border-radius: 13px;
                border-width: entry.playing || entry-hover.has-hover ? 1px : 0px; border-color: entry.playing ? #ff9900 : #493419;
                background: entry.playing ? #241b10 : entry-hover.has-hover ? #252321 : #191919;
                animate background { duration: root.reduce-motion ? 0ms : 160ms; easing: ease-out; }
                animate border-width { duration: root.reduce-motion ? 0ms : 130ms; easing: ease-out; }
                animate border-color { duration: root.reduce-motion ? 0ms : 160ms; easing: ease-out; }
                HorizontalLayout {
                    width: 100%; height: 100%; padding-left: 12px; padding-right: 8px; spacing: 11px;
                    Rectangle {
                        width: 88px; height: 58px; border-radius: 8px; background: #141417;
                        Image { source: entry.thumbnail; image-fit: cover; width: 88px; height: 58px; }
                        Rectangle { width: 26px; height: 26px; border-radius: 13px; background: #99090b0d; x: parent.width / 2 - self.width / 2; y: parent.height / 2 - self.height / 2; Image { source: @image-url("icons/play.svg"); width: 12px; height: 12px; x: parent.width / 2 - self.width / 2; y: parent.height / 2 - self.height / 2; } }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; alignment: center; spacing: 2px;
                        Text { text: entry.title; color: #eceef1; font-size: 12px; font-weight: 600; overflow: elide; }
                        Text { text: entry.subtitle; color: #8f95a0; font-size: 10px; overflow: elide; }
                    }
                    Rectangle {
                        width: 36px; height: 36px; border-radius: 18px; background: favorite-hover.has-hover ? #30211d : transparent;
                        animate background { duration: 140ms; easing: ease-out; }
                        Text { width: 100%; height: 100%; text: "♡"; color: favorite-hover.has-hover ? #ff9d83 : #c5c8cf; font-size: 21px; horizontal-alignment: center; vertical-alignment: center; animate color { duration: 140ms; easing: ease-out; } }
                        favorite-hover := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-favorite(entry.path); } }
                    }
                }
                entry-hover := TouchArea { mouse-cursor: pointer; clicked => { root.open-item(entry.path); } }
            }
        }
    }
}

component HomePage inherits Rectangle {
    in property <string> media-title: "";
    in property <string> status: "";
    in property <string> summary: "";
    in property <bool> reduce-motion: false;
    callback browse-files();
    callback browse-folder();
    callback open-url();
    callback continue-media();

    background: transparent;
    VerticalLayout {
        width: 100%;
        height: 100%;
        cross-axis-alignment: center;
        alignment: center;
        spacing: 0px;

        Rectangle {
            width: 76px;
            height: 76px;
            border-radius: 22px;
            border-width: 1px;
            border-color: #3b2a12;
            background: #1c1812;
            Image { source: @image-url("assets/fluent-player.jpg"); width: 74px; height: 74px; image-fit: contain; }
        }
        Rectangle { height: 23px; background: transparent; }
        Text {
            width: 100%;
            height: 40px;
            text: "Your cinema, organized";
            color: #f4f4f6;
            font-size: 32px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle { height: 13px; background: transparent; }
        Text {
            width: 100%;
            height: 20px;
            text: "Browse files, continue watching, or build a local media library.";
            color: #aeb3bf;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle { height: 14px; background: transparent; }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Rectangle {
                width: 116px;
                height: 42px;
                border-radius: 13px;
                border-width: 1px; border-color: files-hover.has-hover ? #ffbd52 : #ffad24;
                background: files-hover.pressed ? #d98200 : files-hover.has-hover ? #ffad24 : #ff9900;
                animate background { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }
                animate border-color { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }
                HorizontalLayout { width: 100%; height: 100%; alignment: center; spacing: 7px;
                    Image { source: @image-url("icons/folder-dark.svg"); width: 16px; height: 16px; }
                    Text { text: "Open Files"; color: #17130d; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                }
                files-hover := TouchArea { mouse-cursor: pointer; clicked => { root.browse-files(); } }
            }
            Rectangle {
                width: 124px;
                height: 42px;
                border-radius: 13px;
                border-width: 1px; border-color: folder-hover.has-hover ? #5a482d : #39352f;
                background: folder-hover.pressed ? #1a1917 : folder-hover.has-hover ? #292725 : #222222;
                animate background { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }
                animate border-color { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }
                HorizontalLayout { width: 100%; height: 100%; alignment: center; spacing: 7px;
                    Image { source: @image-url("icons/folder-active.svg"); width: 16px; height: 16px; }
                    Text { text: "Open Folder"; color: #f2f2f2; font-size: 12px; font-weight: 650; vertical-alignment: center; }
                }
                folder-hover := TouchArea { mouse-cursor: pointer; clicked => { root.browse-folder(); } }
            }
            Rectangle {
                width: 108px;
                height: 42px;
                border-radius: 13px;
                border-width: 1px; border-color: url-hover.has-hover ? #5a482d : #39352f;
                background: url-hover.pressed ? #1a1917 : url-hover.has-hover ? #292725 : #222222;
                animate background { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }
                animate border-color { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }
                HorizontalLayout { width: 100%; height: 100%; alignment: center; spacing: 7px;
                    Text { text: "↗"; color: #ffad24; font-size: 15px; vertical-alignment: center; }
                    Text { text: "Open URL"; color: #f2f2f2; font-size: 12px; font-weight: 650; vertical-alignment: center; }
                }
                url-hover := TouchArea { mouse-cursor: pointer; clicked => { root.open-url(); } }
            }
        }
        Rectangle { height: 14px; background: transparent; }
        Text { width: 100%; height: 24px; text: root.summary; color: #aeb3bf; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        Rectangle { height: 12px; background: transparent; }
        Rectangle {
            width: 280px;
            height: 42px;
            border-radius: 13px;
            border-width: 1px;
            border-color: #493419;
            background: continue-hover.has-hover ? #2b2114 : #211a11;
            animate background { duration: root.reduce-motion ? 0ms : 160ms; easing: ease-out; }
            HorizontalLayout {
                width: 100%;
                height: 100%;
                alignment: center;
                spacing: 7px;
                Image { source: @image-url("icons/play.svg"); width: 13px; height: 13px; }
                Text { text: root.media-title == "" ? "Open a video to get started" : root.media-title; color: #ffb13b; font-size: 12px; font-weight: 700; vertical-alignment: center; }
            }
            continue-hover := TouchArea { mouse-cursor: pointer; clicked => { root.continue-media(); } }
        }
        Rectangle { height: 10px; background: transparent; }
        Text {
            width: 100%;
            height: 20px;
            text: root.status;
            color: #ffad24;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: root.status == "" ? 0 : 1;
        }
    }
}

component PlaybackPage inherits Rectangle {
    in property <string> filename: "";
    in property <bool> paused: false;
    in property <float> progress: 0;
    in property <float> duration: 0;
    in property <string> current-time: "00:00:00";
    in property <string> total-time: "00:00:00";
    in property <float> volume: 100;
    in property <string> volume-label: "100%";
    in property <string> speed-label: "1.00×";
    in property <bool> hardware-decoding: true;
    in property <bool> reduce-motion: false;
    callback pause-play();
    callback previous();
    callback next();
    callback set-volume(float);
    callback toggle-mute();
    callback picture-in-picture();
    callback show-settings();
    callback open-playlist();
    callback seek-to(float);
    background: #0d0d0d;

    Rectangle { x: 5px; y: 38px; width: parent.width - 10px; height: parent.height - 102px; border-radius: 11px; background: #000000; }

    Rectangle {
        x: 0px; y: parent.height - 64px; width: 100%; height: 64px;
        background: #202020;
        HorizontalLayout {
            x: 16px; y: 0px; width: parent.width - 32px; height: 100%; spacing: 9px;
            cross-axis-alignment: center;
            Rectangle {
                width: 30px; height: 36px; border-radius: 18px; background: prev-hover.has-hover ? #383838 : transparent;
                animate background { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
                Image { source: @image-url("icons/skip-back.svg"); width: 16px; height: 16px; x: 7px; y: 10px; }
                prev-hover := TouchArea { mouse-cursor: pointer; clicked => { root.previous(); } }
            }
            Rectangle {
                width: 40px; height: 40px; border-radius: 20px; background: play-hover.has-hover ? #ffad24 : #ff9900;
                animate background { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
                animate border-radius { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
                if root.paused: Text { text: "▶"; x: 1px; y: 0px; width: parent.width; height: parent.height; color: #171717; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                if !root.paused: HorizontalLayout { width: 12px; height: 14px; spacing: 3px; x: parent.width / 2 - self.width / 2; y: parent.height / 2 - self.height / 2; Rectangle { width: 4px; height: 14px; border-radius: 1px; background: #141414; } Rectangle { width: 4px; height: 14px; border-radius: 1px; background: #141414; } }
                play-hover := TouchArea { mouse-cursor: pointer; clicked => { root.pause-play(); } }
            }
            Rectangle {
                width: 30px; height: 36px; border-radius: 18px; background: next-hover.has-hover ? #383838 : transparent;
                animate background { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
                Image { source: @image-url("icons/skip-forward.svg"); width: 16px; height: 16px; x: 7px; y: 10px; }
                next-hover := TouchArea { mouse-cursor: pointer; clicked => { root.next(); } }
            }
            Text { text: root.current-time; width: 68px; height: 32px; color: #eeeeee; font-size: 12px; vertical-alignment: center; }
            Rectangle {
                horizontal-stretch: 1; height: 32px; background: transparent;
                Rectangle { x: 0px; y: 14px; width: 100%; height: 4px; border-radius: 2px; background: #080808; }
                Rectangle { x: 0px; y: 14px; width: parent.width * root.progress; height: 4px; border-radius: 2px; background: #ff9900; animate width { duration: root.reduce-motion ? 0ms : 120ms; easing: ease-out; } }
                Rectangle { x: parent.width * root.progress - 5px; y: 11px; width: 10px; height: 10px; border-radius: 5px; background: #ff9900; }
                TouchArea { x: 0px; y: 0px; width: 100%; height: 32px; mouse-cursor: pointer; clicked => { root.seek-to(root.duration * (self.mouse-x / self.width)); } }
            }
            Text { text: root.total-time; width: 68px; height: 32px; color: #eeeeee; font-size: 12px; vertical-alignment: center; }
            Rectangle {
                width: 24px; height: 32px; background: transparent;
                Image { source: @image-url("icons/volume.svg"); width: 19px; height: 19px; x: 2px; y: 6px; }
                TouchArea { mouse-cursor: pointer; clicked => { root.toggle-mute(); } }
            }
            Rectangle {
                width: 88px; height: 32px; background: transparent;
                Rectangle { x: 0px; y: 14px; width: 100%; height: 4px; border-radius: 2px; background: #080808; }
                Rectangle { x: 0px; y: 14px; width: parent.width * (root.volume / 200); height: 4px; border-radius: 2px; background: #ff9900; animate width { duration: root.reduce-motion ? 0ms : 120ms; easing: ease-out; } }
                Rectangle { x: parent.width * (root.volume / 200) - 5px; y: 11px; width: 10px; height: 10px; border-radius: 5px; background: #ff9900; }
                TouchArea { x: 0px; y: 0px; width: 100%; height: 32px; mouse-cursor: pointer; clicked => { root.set-volume(200 * (self.mouse-x / self.width)); } }
            }
            Rectangle { width: 28px; height: 32px; border-radius: 4px; background: pip-hover.has-hover ? #383838 : transparent;
                animate background { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
                Rectangle { x: 5px; y: 6px; width: 16px; height: 13px; border-radius: 2px; border-width: 1px; border-color: #cfcfcf; background: transparent; }
                Rectangle { x: 13px; y: 12px; width: 9px; height: 7px; border-radius: 1px; border-width: 1px; border-color: #cfcfcf; background: #202020; }
                pip-hover := TouchArea { mouse-cursor: pointer; clicked => { root.picture-in-picture(); } }
            }
            Rectangle { width: 28px; height: 32px; border-radius: 4px; background: settings-hover.has-hover ? #383838 : transparent;
                animate background { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
                Text { text: "⚙"; width: 100%; height: 100%; color: #d5d5d5; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                settings-hover := TouchArea { mouse-cursor: pointer; clicked => { root.show-settings(); } }
            }
            Rectangle { width: 28px; height: 32px; border-radius: 4px; background: queue-hover.has-hover ? #383838 : transparent;
                animate background { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
                Image { source: @image-url("icons/playlist.svg"); width: 19px; height: 19px; x: 4px; y: 6px; }
                queue-hover := TouchArea { mouse-cursor: pointer; clicked => { root.open-playlist(); } }
            }
        }
    }
}

component UrlPage inherits Rectangle {
    in-out property <string> url: "";
    in property <bool> reduce-motion: false;
    callback submit(string);
    callback cancel();
    background: transparent;
    VerticalLayout {
        width: 100%; height: 100%; cross-axis-alignment: center; alignment: center; spacing: 12px;
        Text { width: 100%; text: "Play from URL"; color: #f2f3f6; font-size: 25px; font-weight: 700; horizontal-alignment: center; }
        Text { width: 100%; text: "Paste a direct media link supported by mpv."; color: #9ba0ab; font-size: 12px; horizontal-alignment: center; }
        Rectangle {
            width: 430px; height: 46px; border-radius: 10px; background: #1d1d21;
            LineEdit { x: 12px; y: 6px; width: parent.width - 24px; height: 34px; text <=> root.url; placeholder-text: "https://example.com/video.mp4"; }
        }
        Rectangle {
            width: 142px; height: 38px; border-radius: 19px;
            border-width: 1px; border-color: submit-hover.has-hover ? #ffbd52 : #ffad24;
            background: submit-hover.pressed ? #d98200 : submit-hover.has-hover ? #ffad24 : #ff9900;
            animate background { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }
            animate border-color { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }
            Text { width: 100%; height: 100%; text: "Play video"; color: #17130d; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            submit-hover := TouchArea { mouse-cursor: pointer; clicked => { root.submit(root.url); } }
        }
        Rectangle {
            width: 100px; height: 34px; border-radius: 12px; background: back-hover.has-hover ? #2a2722 : transparent;
            animate background { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
            Text { width: 100%; height: 100%; text: "←  Home"; color: #b8bdc7; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
            back-hover := TouchArea { mouse-cursor: pointer; clicked => { root.cancel(); } }
        }
    }
}

component SettingsPage inherits Rectangle {
    in property <bool> reduce-motion: false;
    in property <bool> hardware-decoding: true;
    in property <string> playback-volume: "100%";
    in property <string> playback-speed: "1.0×";
    callback toggle-reduced-motion();
    callback toggle-hardware-decoding();
    callback volume-down();
    callback volume-up();
    callback speed-down();
    callback speed-up();
    callback reset-video();
    callback screenshot();
    callback adjust-video(string, float);
    background: transparent;

    VerticalLayout {
        width: 100%; height: 100%;
        padding-left: 28px; padding-right: 28px; padding-top: 20px; padding-bottom: 22px;
        spacing: 14px;
        Text { text: "Preferences"; color: #f5f5f7; font-size: 23px; font-weight: 700; }
        Text { text: "Playback and interface behavior"; color: #b8bac4; font-size: 12px; }
        Rectangle { height: 4px; background: transparent; }
        Rectangle {
            width: 100%; height: 76px; border-radius: 12px; background: #1d1d21;
            HorizontalLayout {
                x: 16px; y: 0px; width: parent.width - 32px; height: 100%; spacing: 12px;
                VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                    Text { text: "Reduce motion"; color: #f5f5f7; font-size: 13px; font-weight: 600; }
                    Text { text: "Use shorter transitions and minimal movement"; color: #b8bac4; font-size: 11px; }
                }
                PlayerChip { reduce-motion: root.reduce-motion; label: root.reduce-motion ? "ON" : "OFF"; active: root.reduce-motion; width: 54px; clicked => { root.toggle-reduced-motion(); } }
            }
        }
        Rectangle {
            width: 100%; height: 76px; border-radius: 12px; background: #1d1d21;
            HorizontalLayout {
                x: 16px; y: 0px; width: parent.width - 32px; height: 100%; spacing: 12px;
                VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                    Text { text: "Hardware decoding"; color: #f5f5f7; font-size: 13px; font-weight: 600; }
                    Text { text: "Toggle mpv hardware video decoding"; color: #b8bac4; font-size: 11px; }
                }
                PlayerChip { reduce-motion: root.reduce-motion; label: root.hardware-decoding ? "ON" : "OFF"; active: root.hardware-decoding; width: 54px; clicked => { root.toggle-hardware-decoding(); } }
            }
        }
        Rectangle {
            width: 100%; height: 76px; border-radius: 12px; background: #1d1d21;
            HorizontalLayout {
                x: 16px; y: 0px; width: parent.width - 32px; height: 100%; spacing: 8px;
                VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                    Text { text: "Volume"; color: #f5f5f7; font-size: 13px; font-weight: 600; }
                    Text { text: root.playback-volume; color: #b8bac4; font-size: 11px; }
                }
                PlayerChip { reduce-motion: root.reduce-motion; label: "−"; clicked => { root.volume-down(); } }
                PlayerChip { reduce-motion: root.reduce-motion; label: "+"; clicked => { root.volume-up(); } }
            }
        }
        Rectangle {
            width: 100%; height: 76px; border-radius: 12px; background: #1d1d21;
            HorizontalLayout {
                x: 16px; y: 0px; width: parent.width - 32px; height: 100%; spacing: 8px;
                VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                    Text { text: "Playback speed"; color: #f5f5f7; font-size: 13px; font-weight: 600; }
                    Text { text: root.playback-speed; color: #b8bac4; font-size: 11px; }
                }
                PlayerChip { reduce-motion: root.reduce-motion; label: "−"; clicked => { root.speed-down(); } }
                PlayerChip { reduce-motion: root.reduce-motion; label: "+"; clicked => { root.speed-up(); } }
            }
        }
        HorizontalLayout {
            width: 100%; spacing: 10px;
            Rectangle { width: 170px; height: 38px; border-radius: 12px; background: reset-hover.has-hover ? #2a2a2a : #1d1d1d;
                animate background { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
                Text { text: "Reset video adjustments"; width: 100%; height: 100%; color: #f5f5f7; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                reset-hover := TouchArea { mouse-cursor: pointer; clicked => { root.reset-video(); } }
            }
            Rectangle { width: 120px; height: 38px; border-radius: 12px; border-width: 1px; border-color: #ffad24; background: screenshot-hover.has-hover ? #ffad24 : #ff9900;
                animate background { duration: root.reduce-motion ? 0ms : 150ms; easing: ease-out; }
                Text { text: "Screenshot"; width: 100%; height: 100%; color: #17130d; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                screenshot-hover := TouchArea { mouse-cursor: pointer; clicked => { root.screenshot(); } }
            }
        }
        Rectangle {
            width: 100%; height: 76px; border-radius: 12px; background: #1d1d21;
            HorizontalLayout {
                x: 16px; y: 0px; width: parent.width - 32px; height: 100%; spacing: 6px;
                VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                    Text { text: "Video adjustments"; color: #f5f5f7; font-size: 13px; font-weight: 600; }
                    Text { text: "Brightness · contrast · saturation · gamma"; color: #b8bac4; font-size: 11px; }
                }
                PlayerChip { reduce-motion: root.reduce-motion; label: "B−"; clicked => { root.adjust-video("brightness", -5); } }
                PlayerChip { reduce-motion: root.reduce-motion; label: "B+"; clicked => { root.adjust-video("brightness", 5); } }
                PlayerChip { reduce-motion: root.reduce-motion; label: "C−"; clicked => { root.adjust-video("contrast", -5); } }
                PlayerChip { reduce-motion: root.reduce-motion; label: "C+"; clicked => { root.adjust-video("contrast", 5); } }
                PlayerChip { reduce-motion: root.reduce-motion; label: "S−"; clicked => { root.adjust-video("saturation", -5); } }
                PlayerChip { reduce-motion: root.reduce-motion; label: "S+"; clicked => { root.adjust-video("saturation", 5); } }
                PlayerChip { reduce-motion: root.reduce-motion; label: "G−"; clicked => { root.adjust-video("gamma", -5); } }
                PlayerChip { reduce-motion: root.reduce-motion; label: "G+"; clicked => { root.adjust-video("gamma", 5); } }
            }
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}

export component MainWindow inherits Window {
    title: root.selected-media == "" ? "Fluent Player" : root.selected-media + " - Fluent Player";
    no-frame: true;
    preferred-width: 1280px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 500px;
    default-font-family: "Segoe UI";
    background: #0d0d0d;

    in-out property <string> current-page: "Home";
    in-out property <string> notice: "";
    in-out property <bool> sidebar-collapsed: false;
    in-out property <string> selected-media: "";
    in-out property <bool> playback-paused: false;
    in-out property <float> playback-progress: 0;
    in-out property <float> playback-duration: 0;
    in-out property <string> playback-time: "00:00 / 00:00";
    in-out property <string> playback-current-time: "00:00:00";
    in-out property <string> playback-total-time: "00:00:00";
    in-out property <float> playback-volume: 100;
    in-out property <string> source-url: "";
    in-out property <string> activity-summary: "Choose a video or folder to start your library";
    in-out property <[MediaEntry]> media-items: [];
    in-out property <[MediaEntry]> library-items: [];
    in-out property <[MediaEntry]> favorite-items: [];
    in-out property <[MediaEntry]> recent-items: [];
    in-out property <[MediaEntry]> history-items: [];
    in-out property <[MediaEntry]> playlist-items: [];
    in-out property <string> playback-volume-label: "100%";
    in-out property <string> playback-speed-label: "1.0×";
    in-out property <bool> hardware-decoding: true;
    in-out property <bool> reduce-motion: false;
    in-out property <bool> fullscreen: false;
    in-out property <bool> window-maximized: false;
    in-out property <bool> pip-mode: false;
    callback open-files();
    callback open-folder();
    callback add-library-folder();
    callback continue-media();
    callback home-player();
    callback pause-player();
    callback skip-back-player();
    callback skip-forward-player();
    callback previous-player();
    callback next-player();
    callback toggle-mute-player();
    callback toggle-captions-player();
    callback toggle-repeat-player();
    callback show-recent();
    callback show-playlist();
    callback play-queued(string);
    callback seek-player(float);
    callback volume-down-player();
    callback volume-up-player();
    callback speed-down-player();
    callback speed-up-player();
    callback cycle-audio-player();
    callback cycle-subtitle-player();
    callback toggle-hardware-decoding-player();
    callback toggle-playlist-repeat-player();
    callback toggle-reduced-motion();
    callback reset-video-player();
    callback screenshot-player();
    callback adjust-video-player(string, float);
    callback step-frame-player();
    callback toggle-ab-loop-player();
    callback toggle-fullscreen-player();
    callback set-volume-player(float);
    callback picture-in-picture-player();
    callback show-settings-player();
    callback minimize-window-player();
    callback maximize-window-player();
    callback close-window-player();
    callback open-media(string);
    callback toggle-favorite(string);
    callback open-place(string);

    if !root.sidebar-collapsed && root.current-page != "Player": Rectangle {
            x: 0px;
            y: 38px;
            width: 232px;
            height: parent.height - 38px;
            background: #121212;
            VerticalLayout {
                width: 100%;
                height: 100%;
                padding-left: 8px;
                padding-right: 8px;
                padding-top: root.height < 600px ? 26px : 60px;
                spacing: 0px;

                SidebarItem { reduce-motion: root.reduce-motion;
                    label: "Home";
                    icon: @image-url("icons/home.svg");
                    hover-icon: @image-url("icons/home-active.svg");
                    active: root.current-page == "Home";
                    row-height: root.height < 600px ? 38px : 44px;
                    selected => { root.current-page = "Home"; root.notice = ""; }
                }
                Rectangle { height: root.height < 600px ? 6px : 10px; background: transparent; }
                SidebarItem { reduce-motion: root.reduce-motion; label: "Browse"; icon: @image-url("icons/folder.svg"); hover-icon: @image-url("icons/folder-active.svg"); active: root.current-page == "Browse"; row-height: root.height < 600px ? 34px : 47px; selected => { root.current-page = "Browse"; root.notice = ""; } }
                SidebarItem { reduce-motion: root.reduce-motion; label: "Library"; icon: @image-url("icons/library.svg"); hover-icon: @image-url("icons/library-active.svg"); active: root.current-page == "Library"; row-height: root.height < 600px ? 34px : 47px; selected => { root.current-page = "Library"; root.notice = ""; } }
                SidebarItem { reduce-motion: root.reduce-motion; label: "Favorites"; icon: @image-url("icons/heart.svg"); hover-icon: @image-url("icons/heart-active.svg"); active: root.current-page == "Favorites"; row-height: root.height < 600px ? 34px : 47px; selected => { root.current-page = "Favorites"; root.notice = ""; } }
                SidebarItem { reduce-motion: root.reduce-motion; label: "Recent"; icon: @image-url("icons/recent.svg"); hover-icon: @image-url("icons/recent-active.svg"); active: root.current-page == "Recent"; row-height: root.height < 600px ? 34px : 47px; selected => { root.current-page = "Recent"; root.notice = ""; } }
                SidebarItem { reduce-motion: root.reduce-motion; label: "History"; icon: @image-url("icons/history.svg"); hover-icon: @image-url("icons/history-active.svg"); active: root.current-page == "History"; row-height: root.height < 600px ? 34px : 47px; selected => { root.current-page = "History"; root.notice = ""; } }
                SidebarItem { reduce-motion: root.reduce-motion; label: "Settings"; icon: @image-url("icons/menu.svg"); hover-icon: @image-url("icons/menu.svg"); active: root.current-page == "Settings"; row-height: root.height < 600px ? 34px : 47px; selected => { root.current-page = "Settings"; root.notice = ""; } }

                Rectangle { height: root.height < 600px ? 8px : 16px; background: transparent; }
                Rectangle { height: 1px; background: #39393d; }
                Rectangle { height: root.height < 600px ? 8px : 20px; background: transparent; }
                Text { text: "PLACES"; color: #b8bac3; font-size: 10px; font-weight: 700; }
                Rectangle { height: root.height < 600px ? 4px : 7px; background: transparent; }

                for place[index] in ["Home", "Videos", "Music", "Downloads", "C:\\", "D:\\"] : SidebarItem { reduce-motion: root.reduce-motion;
                    label: place;
                    icon: @image-url("icons/folder.svg");
                    hover-icon: @image-url("icons/folder-active.svg");
                    place-item: true;
                    row-height: root.height < 600px ? 28px : 41px;
                    selected => { root.open-place(place); }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle {
                    height: root.height < 600px ? 36px : 46px;
                    border-radius: 9px;
                    border-width: 1px; border-color: add-hover.has-hover ? #4a3517 : #303030;
                    background: add-hover.has-hover ? #29241d : #1c1c1c;
                    animate background { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
                    animate border-color { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 12px;
                        spacing: 9px;
                        Rectangle {
                            width: 18px;
                            height: 100%;
                            Image { source: @image-url("icons/plus.svg"); width: 18px; height: 18px; x: 0px; y: parent.height / 2 - self.height / 2 + (add-hover.has-hover ? 0px : 1px); animate y { duration: 140ms; easing: ease-out; } }
                        }
                        Text { text: "Add Library Folder"; color: #f1f2f5; font-size: 11px; font-weight: 700; height: 100%; vertical-alignment: center; }
                    }
                    add-hover := TouchArea { mouse-cursor: pointer; clicked => { root.add-library-folder(); } }
                }
            }
        }

        if root.current-page != "Player": Rectangle {
            x: root.sidebar-collapsed ? 0px : 232px;
            y: 38px;
            width: root.width - (root.sidebar-collapsed ? 0px : 232px);
            height: root.height - 38px;
            background: #0d0d0d;
            VerticalLayout {
                width: 100%;
                height: 100%;
                spacing: 0px;
                Rectangle {
                    width: 100%;
                    height: 36px;
                    Rectangle {
                        x: parent.width - 44px;
                        y: 0px;
                        width: 44px;
                        height: 36px;
                        background: transparent;
                        Rectangle {
                            width: 32px;
                            height: 36px;
                            background: menu-hover.has-hover ? #29241d : transparent;
                            border-radius: 9px;
                            animate background { duration: root.reduce-motion ? 0ms : 140ms; easing: ease-out; }
                            Image { source: @image-url("icons/menu.svg"); width: 16px; height: 16px; x: 8px; y: 10px; }
                            menu-hover := TouchArea {
                                width: 32px;
                                height: 36px;
                                mouse-cursor: pointer;
                                clicked => { root.sidebar-collapsed = !root.sidebar-collapsed; }
                            }
                        }
                    }
                }
                Rectangle {
                    width: 100%;
                    height: 68px;
                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 20px;
                        Text { width: 100%; height: 100%; text: root.current-page == "Home" ? "Media Hub" : root.current-page; color: #f3f4f7; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                    }
                }
                Rectangle { width: 100%; height: 1px; background: #292a2e; }

                if root.current-page == "Home": HomePage {
                    width: 100%;
                    height: 100%;
                    vertical-stretch: 1;
                    media-title: root.selected-media;
                    status: root.notice;
                    summary: root.activity-summary;
                    reduce-motion: root.reduce-motion;
                    browse-files => { root.open-files(); }
                    browse-folder => { root.open-folder(); }
                    open-url => { root.current-page = "Open URL"; root.notice = "Paste a video URL to continue."; }
                    continue-media => { root.continue-media(); }
                }

                if root.current-page == "Browse": MediaPage {
                    width: 100%; height: 100%; vertical-stretch: 1;
                    reduce-motion: root.reduce-motion;
                    heading: "Browse";
                    description: root.notice == "" ? "Videos in the folder you selected" : root.notice;
                    items: root.media-items;
                    choose-folder => { root.open-folder(); }
                    open-item(path) => { root.open-media(path); }
                    toggle-favorite(path) => { root.toggle-favorite(path); }
                }
                if root.current-page == "Library": MediaPage {
                    width: 100%; height: 100%; vertical-stretch: 1;
                    reduce-motion: root.reduce-motion;
                    heading: "Your library";
                    description: "Videos found in your library folders";
                    items: root.library-items;
                    choose-folder => { root.add-library-folder(); }
                    open-item(path) => { root.open-media(path); }
                    toggle-favorite(path) => { root.toggle-favorite(path); }
                }
                if root.current-page == "Favorites": MediaPage {
                    width: 100%; height: 100%; vertical-stretch: 1;
                    reduce-motion: root.reduce-motion;
                    heading: "Favorites";
                    description: "Your saved videos";
                    items: root.favorite-items;
                    choose-folder => { root.current-page = "Browse"; }
                    open-item(path) => { root.open-media(path); }
                    toggle-favorite(path) => { root.toggle-favorite(path); }
                }
                if root.current-page == "Recent": MediaPage {
                    width: 100%; height: 100%; vertical-stretch: 1;
                    reduce-motion: root.reduce-motion;
                    heading: "Recently played";
                    description: "Pick up where you left off";
                    items: root.recent-items;
                    choose-folder => { root.open-files(); }
                    open-item(path) => { root.open-media(path); }
                    toggle-favorite(path) => { root.toggle-favorite(path); }
                }
                if root.current-page == "History": MediaPage {
                    width: 100%; height: 100%; vertical-stretch: 1;
                    reduce-motion: root.reduce-motion;
                    heading: "Watch history";
                    description: "Your playback activity";
                    items: root.history-items;
                    choose-folder => { root.open-files(); }
                    open-item(path) => { root.open-media(path); }
                    toggle-favorite(path) => { root.toggle-favorite(path); }
                }
                if root.current-page == "Playlist": MediaPage {
                    width: 100%; height: 100%; vertical-stretch: 1;
                    reduce-motion: root.reduce-motion;
                    heading: "Now playing";
                    description: "Items queued for playback";
                    items: root.playlist-items;
                    choose-folder => { root.open-files(); }
                    open-item(path) => { root.play-queued(path); }
                    toggle-favorite(path) => { root.toggle-favorite(path); }
                }
                if root.current-page == "Open URL": UrlPage {
                    width: 100%; height: 100%; vertical-stretch: 1;
                    reduce-motion: root.reduce-motion;
                    url: root.source-url;
                    submit(address) => { root.open-media(address); }
                    cancel => { root.current-page = "Home"; root.notice = ""; }
                }
                if root.current-page == "Settings": SettingsPage {
                    width: 100%; height: 100%; vertical-stretch: 1;
                    reduce-motion: root.reduce-motion;
                    hardware-decoding: root.hardware-decoding;
                    playback-volume: root.playback-volume-label;
                    playback-speed: root.playback-speed-label;
                    toggle-reduced-motion => { root.toggle-reduced-motion(); }
                    toggle-hardware-decoding => { root.toggle-hardware-decoding-player(); }
                    volume-down => { root.volume-down-player(); }
                    volume-up => { root.volume-up-player(); }
                    speed-down => { root.speed-down-player(); }
                    speed-up => { root.speed-up-player(); }
                    reset-video => { root.reset-video-player(); }
                    screenshot => { root.screenshot-player(); }
                    adjust-video(property, delta) => { root.adjust-video-player(property, delta); }
                }
            }
        }
    if root.current-page == "Player": PlaybackPage {
        width: 100%; height: 100%;
        filename: root.selected-media;
        paused: root.playback-paused;
        progress: root.playback-progress;
        duration: root.playback-duration;
        current-time: root.playback-current-time;
        total-time: root.playback-total-time;
        volume: root.playback-volume;
        volume-label: root.playback-volume-label;
        speed-label: root.playback-speed-label;
        hardware-decoding: root.hardware-decoding;
        reduce-motion: root.reduce-motion;
        pause-play => { root.pause-player(); }
        previous => { root.previous-player(); }
        next => { root.next-player(); }
        set-volume(value) => { root.set-volume-player(value); }
        toggle-mute => { root.toggle-mute-player(); }
        picture-in-picture => { root.picture-in-picture-player(); }
        show-settings => { root.show-settings-player(); }
        open-playlist => { root.show-playlist(); }
        seek-to(seconds) => { root.seek-player(seconds); }
    }

    Rectangle {
        x: 0px; y: 0px; width: 100%; height: 38px;
        background: #202020;
        Rectangle { x: 0px; y: parent.height - 1px; width: 100%; height: 1px; background: #2b2b2b; }

        Rectangle {
            x: 8px; y: 0px; width: 22px; height: 38px;
            Image { source: @image-url("assets/fluent-player.jpg"); x: 0px; y: 7px; width: 22px; height: 22px; image-fit: contain; }
        }
        Rectangle {
            x: 35px; y: 0px; width: 34px; height: 38px;
            background: dots-hover.has-hover ? #38302a : transparent;
            animate background { duration: root.reduce-motion ? 0ms : 130ms; easing: ease-out; }
            Text { text: "•••"; width: 100%; height: 100%; color: #d7d7d7; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
            dots-hover := TouchArea { mouse-cursor: pointer; clicked => { root.show-playlist(); } }
        }
        Text {
            x: 78px; y: 0px; width: 64px; height: 100%;
            text: "Videos"; color: #d7d7d7; font-size: 12px; vertical-alignment: center;
        }

        WindowMoveArea {
            x: 150px; y: 0px; width: parent.width - 288px; height: 100%;
            Text {
                width: 100%; height: 100%;
                text: root.current-page == "Player" ? root.selected-media : (root.current-page == "Home" ? "Fluent Player" : root.current-page);
                color: #d2d2d2; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
            }
        }

        Rectangle {
            x: parent.width - 138px; y: 0px; width: 46px; height: 38px;
            background: minimize-hover.has-hover ? #3a3a3a : transparent;
            animate background { duration: root.reduce-motion ? 0ms : 130ms; easing: ease-out; }
            Rectangle { x: 18px; y: 18px; width: 10px; height: 1px; background: #e3e3e3; }
            minimize-hover := TouchArea { mouse-cursor: pointer; clicked => { root.minimize-window-player(); } }
        }
        Rectangle {
            x: parent.width - 92px; y: 0px; width: 46px; height: 38px;
            background: maximize-hover.has-hover ? #3a3a3a : transparent;
            animate background { duration: root.reduce-motion ? 0ms : 130ms; easing: ease-out; }
            if !root.window-maximized: Rectangle { x: 18px; y: 13px; width: 11px; height: 11px; border-width: 1px; border-color: #e3e3e3; background: transparent; }
            if root.window-maximized: Rectangle {
                x: 17px; y: 12px; width: 10px; height: 10px; border-width: 1px; border-color: #e3e3e3; background: #202020;
                Rectangle { x: 3px; y: 3px; width: 10px; height: 10px; border-width: 1px; border-color: #e3e3e3; background: #202020; }
            }
            maximize-hover := TouchArea { mouse-cursor: pointer; clicked => { root.maximize-window-player(); } }
        }
        Rectangle {
            x: parent.width - 46px; y: 0px; width: 46px; height: 38px;
            background: close-hover.has-hover ? #c42b1c : transparent;
            animate background { duration: root.reduce-motion ? 0ms : 130ms; easing: ease-out; }
            Text { text: "×"; width: 100%; height: 100%; color: #e3e3e3; font-size: 19px; horizontal-alignment: center; vertical-alignment: center; }
            close-hover := TouchArea { mouse-cursor: pointer; clicked => { root.close-window-player(); } }
        }
    }
}
